{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "otfshow",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-05-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "SUBMISSIONS", "id": "2b783e92b7fb486f91a498e1d35ef284" }
  ]
}
